# Copy to .env (or server/.env) and adjust. Never commit real secrets.

# Port the API server listens on. The Vite dev server proxies /api here.
PORT=3001

# SQLite database file (created on first run). In Docker this lives on the `data` volume.
DATABASE_PATH=./data/baktana.db

# Secret used to sign login tokens (JWT). Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production

# development | production. In production the server also serves the built web app (dist/).
NODE_ENV=development

# Optional: AI video-call practice (POST /api/call/turn). Without a key the feature answers 503.
# ANTHROPIC_API_KEY=
# Model for the call; a fast model keeps replies snappy.
# CALL_MODEL=claude-haiku-5-5
# Calls are for signed-in premium learners only: comma-separated account emails (case-insensitive).
# Empty = nobody can call (POST /api/call/turn answers 403 premium_required).
# PREMIUM_EMAILS=
# Testers get a short trial instead: one call a day of up to 10 sentences (shared/call.ts TESTER_LIMITS).
# TESTER_EMAILS=

# Optional: run accounts and the league on Supabase instead of the API server
# (what the GitHub Pages site and the Android app use – see docs/supabase.md).
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Optional: sell premium in the Google Play edition through RevenueCat (docs/subscriptions.md).
# The public Android SDK key (goog_…). Without it premium is "coming soon" and there is no premium screen.
# VITE_REVENUECAT_ANDROID_KEY=
